# Each camera has one ID before firmware and another after it re-enumerates;
# without both, the loaded camera is out of reach. The vendor ID is the STT's own
# 0xDCDC, not Cypress's 0x04B4.

# CSDU-429 / CSDU-423: unconfigured, configured
SUBSYSTEM=="usb", ATTR{idVendor}=="dcdc", ATTR{idProduct}=="f429", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="dcdc", ATTR{idProduct}=="e429", MODE="0666"

# CSDU-285C: unconfigured, configured
SUBSYSTEM=="usb", ATTR{idVendor}=="dcdc", ATTR{idProduct}=="d285", MODE="0666"
SUBSYSTEM=="usb", ATTR{idVendor}=="dcdc", ATTR{idProduct}=="c285", MODE="0666"
