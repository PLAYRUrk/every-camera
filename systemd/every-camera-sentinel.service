# One per machine. A separate service because the failure it reports is a camera
# process that no longer exists. systemd/install.sh fills in the paths below.

[Unit]
Description=Every Camera — alert watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=@APP_DIR@

# run.sh picks the cameras' interpreter: `python3` on CentOS 7 is 3.6.
# No --config: it reads the cameras' configs, so the addresses cannot disagree.
ExecStart=@APP_DIR@/run.sh --sentinel --config-dir @CONFIG_DIR@
Environment=PYTHON=@PYTHON@
Environment=PYTHONUNBUFFERED=1

# Status, logs and the outbox live under $HOME, not root's home.
Environment=HOME=@USER_HOME@

StandardOutput=journal
StandardError=journal
SyslogIdentifier=every-camera-sentinel

# A watchdog left down is worse than none: everyone believes it is watching.
Restart=always
RestartSec=15

# Holds no hardware, and the spool survives on disk.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
