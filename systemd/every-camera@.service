# One instance per camera; the name after "@" goes to main.py --type.
# systemd/install.sh fills in the paths below.

[Unit]
Description=Every Camera — %i
# No Documentation=: systemd rejects non-ASCII paths, which a checkout may have.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=@APP_DIR@

# run.sh keeps the machine environment in env.sh, shared with runs by hand.
ExecStart=@APP_DIR@/run.sh --type %i --config @CONFIG_DIR@/%i.json
Environment=PYTHON=@PYTHON@

# Logs, status and locks live under $HOME; as root they would land in /root,
# out of reach of the operator's monitor_app.py.
Environment=HOME=@USER_HOME@
Environment=PYTHONUNBUFFERED=1

StandardOutput=journal
StandardError=journal
SyslogIdentifier=every-camera-%i

Restart=on-failure
RestartSec=30

# Closing darks and the ASI sensor warm-up (asi.cooling.warm_timeout, 900 s)
# take far longer than systemd's stock 90 s.
KillSignal=SIGTERM
# Needs the `exec` in run.sh: a wrapper would stop SIGTERM before Python. Use
# KillMode=control-group with one.
KillMode=mixed
TimeoutStopSec=1800

[Install]
WantedBy=multi-user.target
