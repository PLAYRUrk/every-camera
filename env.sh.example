# Machine-local environment for run.sh. Copy to env.sh and edit.
#
#   cp env.sh.example env.sh
#
# env.sh is in .gitignore: it describes this machine, not the program, and a
# station's paths have no business in a commit. run.sh sources it before
# starting, so whatever is set here applies both to a run by hand and to the
# systemd service — one description of the machine, not two that drift apart.

# --- Interpreter ------------------------------------------------------------
# Which python runs the program. Leave unset and run.sh looks for a venv beside
# the checkout, then falls back to python3 from PATH — which on a machine with
# anaconda installed is usually anaconda's, and that is a poor choice for a
# service running as root out of a user's home directory.
#PYTHON=/usr/bin/python3.11
#PYTHON=/opt/every-camera-venv/bin/python

# If the dependencies live in a conda environment, activate it here instead of
# setting PYTHON — the activation puts the right interpreter on PATH.
#source /opt/anaconda3/etc/profile.d/conda.sh
#conda activate every-camera

# --- PICAM / Pleora eBUS (ASI camera) ---------------------------------------
# The driver loads libpicam.so through ctypes (cameras/asi/picam.py), and PICAM
# in turn pulls in Pleora's eBUS runtime for GigE cameras. None of these are
# read by Python — they are what the native libraries need — so a login shell
# usually sets them up and a service gets nothing. This is the single most
# common reason an ASI camera that works by hand fails under systemd.
#
# Use the SDK's own environment script rather than spelling the variables out
# here: it is what Pleora ships, it is what the legacy imagerd_rt daemon sources,
# and it assembles LD_LIBRARY_PATH and PATH correctly — which a hand-written list
# of GENICAM_* exports quietly does not.
#source /opt/pleora/ebus_sdk/x86_64/bin/set_puregev_env

# One thing does have to be overridden afterwards. set_puregev_env puts the
# GenICam cache in $HOME/.config/Pleora, and the service runs as root with HOME
# pointed at the operator's home (see the unit) — so root would create and own
# the operator's cache, and a later run by hand could not write to it. That
# surfaces much later as a camera that opens for one of them and not the other.
# A cache per uid can never collide.
#export GENICAM_CACHE_V2_4=/tmp/genicam_cache_v2_4_$(id -u)
#mkdir -p "$GENICAM_CACHE_V2_4" 2>/dev/null

# If libpicam.so lives somewhere the loader does not look:
#export LD_LIBRARY_PATH=/usr/local/lib/picam:${LD_LIBRARY_PATH:-}

# --- Anything else ----------------------------------------------------------
#export EVERY_CAMERA_SOMETHING=...
